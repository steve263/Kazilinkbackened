generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String             @id @default(cuid())
  phone              String?            @unique
  password           String?
  googleId           String?            @unique
  role               Role               @default(CUSTOMER)
  name               String
  location           String?
  lat                Float?
  lng                Float?
  deviceToken        String?
  isOnline           Boolean            @default(false)
  createdAt          DateTime           @default(now())
  isActive           Boolean            @default(true)
  profilePhoto       String?
  email              String?            @unique
  referralCode       String?            @unique
  totalRewards       Float              @default(0)
  isSuspended          Boolean              @default(false)
  bookingsAsCustomer   Booking[]            @relation("CustomerBookings")
  comments             Comment[]
  following            Follow[]             @relation("Follower")
  likes                Like[]
  receivedMessages     Message[]            @relation("ReceivedMessages")
  sentMessages         Message[]            @relation("SentMessages")
  notifications        Notification[]
  provider             Provider?
  waitlistEntries      ProviderWaitlist[]
  referralsReceived    Referral[]           @relation("ReferredReferrals")
  referralsGiven       Referral[]           @relation("ReferrerReferrals")
  reviews              Review[]             @relation("CustomerReviews")
  rewards              Reward[]
  testimonials         Testimonial[]
  tips                 Tip[]
  tipComments          TipComment[]
  videos               Video[]
  videoComments        VideoComment[]
  videoLikes           VideoLike[]
  videoReports         VideoReport[]
  trustScore           TrustScore?
  reportsGiven         Report[]             @relation("ReporterReports")
  reportsReceived      Report[]             @relation("ReportedReports")
  fraudAlerts          FraudAlert[]
  verificationRequests VerificationRequest[]
  suspensionAppeals    SuspensionAppeal[]
  interactions         UserInteraction[]
}

model Provider {
  id                 String             @id @default(cuid())
  userId             String             @unique
  category           ProviderCategory
  businessName       String
  description        String?
  idNumber           String?
  idVerified         Boolean            @default(false)
  portfolioPhotos    String[]
  workingHoursStart  String             @default("08:00")
  workingHoursEnd    String             @default("18:00")
  radiusKm           Int                @default(10)
  minJobValue        Int                @default(500)
  rating             Float              @default(0)
  totalReviews       Int                @default(0)
  isVerified         Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  badge              String?
  coverImage         String?
  idPhotoUrl         String?
  profileImage       String?
  idBackPhotoUrl     String?
  isFeatured         Boolean            @default(false)
  education          String?
  skills             String[]
  yearsExperience    String?
  totalEarned        Float              @default(0)
  walletBalance      Float              @default(0)
  busySince          DateTime?
  isBusy             Boolean            @default(false)
  bookings           Booking[]          @relation("ProviderBookings")
  certificates       Certificate[]
  followers          Follow[]
  portfolioVideos    PortfolioVideo[]
  posts              Post[]
  promotions         Promotion[]
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  waitlist           ProviderWaitlist[]
  reviews            Review[]           @relation("ProviderReviews")
  services           Service[]
  testimonials       Testimonial[]
  videos             Video[]
  withdrawals        Withdrawal[]
  schedule           ProviderAvailability?
  payouts            Payout[]
  location           ProviderLocation?
  interactions       UserInteraction[]
}

model ProviderWaitlist {
  id         String    @id @default(cuid())
  providerId String
  customerId String
  serviceId  String?
  notified   Boolean   @default(false)
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  customer   User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider   Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, customerId, notified])
}

model Service {
  id          String    @id @default(cuid())
  providerId  String
  name        String
  description String?
  price       Int
  priceType   PriceType @default(FIXED)
  duration    Int?
  isActive    Boolean   @default(true)
  bookings    Booking[]
  provider    Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model Booking {
  id            String         @id @default(cuid())
  customerId    String
  providerId    String
  serviceId     String?
  status        BookingStatus  @default(PENDING)
  scheduledDate DateTime
  scheduledTime String
  address       String
  lat           Float?
  lng           Float?
  totalAmount   Int
  paymentStatus PaymentStatus  @default(UNPAID)
  mpesaRef      String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  customer      User           @relation("CustomerBookings", fields: [customerId], references: [id])
  provider      Provider       @relation("ProviderBookings", fields: [providerId], references: [id])
  service       Service?       @relation(fields: [serviceId], references: [id])
  messages      Message[]
  notifications Notification[]
  payment       Payment?
  review        Review?
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  bookingId String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  booking   Booking?         @relation(fields: [bookingId], references: [id])
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String          @id @default(cuid())
  bookingId         String          @unique
  amount            Int
  providerAmount    Float?
  commission        Float?
  phone             String
  mpesaRef          String?
  checkoutRequestId String?
  status            PaymentTxStatus @default(PENDING)
  type              PaymentType     @default(STK_PUSH)
  createdAt         DateTime        @default(now())
  booking           Booking         @relation(fields: [bookingId], references: [id])
}

model Review {
  id           String   @id @default(cuid())
  bookingId    String   @unique
  customerId   String
  providerId   String
  rating       Int
  comment      String?
  createdAt    DateTime @default(now())
  helpfulCount Int      @default(0)
  updatedAt    DateTime @updatedAt
  booking      Booking  @relation(fields: [bookingId], references: [id])
  customer     User     @relation("CustomerReviews", fields: [customerId], references: [id])
  provider     Provider @relation("ProviderReviews", fields: [providerId], references: [id])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  bookingId  String?
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  booking    Booking? @relation(fields: [bookingId], references: [id])
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
}

model Post {
  id              String    @id @default(cuid())
  providerId      String
  caption         String
  image           String?
  type            PostType  @default(WORK)
  hashtags        String[]
  discountPct     Int?
  originalPrice   Int?
  discountedPrice Int?
  promoUntil      DateTime?
  createdAt       DateTime  @default(now())
  comments        Comment[]
  likes           Like[]
  provider        Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Follow {
  id         String   @id @default(cuid())
  followerId String
  providerId String
  createdAt  DateTime @default(now())
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([followerId, providerId])
}

model Certificate {
  id           String            @id @default(cuid())
  providerId   String
  name         String
  fileUrl      String
  publicId     String?
  status       CertificateStatus @default(PENDING)
  rejectReason String?
  createdAt    DateTime          @default(now())
  provider     Provider          @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model PortfolioVideo {
  id           String               @id @default(cuid())
  providerId   String
  url          String
  publicId     String?
  title        String?
  status       PortfolioVideoStatus @default(PENDING)
  rejectReason String?
  createdAt    DateTime             @default(now())
  provider     Provider             @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model Testimonial {
  id           String            @id @default(cuid())
  customerId   String
  providerId   String?
  videoUrl     String
  thumbnailUrl String?
  summary      String
  rating       Int
  category     String
  status       TestimonialStatus @default(PENDING)
  views        Int               @default(0)
  createdAt    DateTime          @default(now())
  rejectReason String?
  customer     User              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider     Provider?         @relation(fields: [providerId], references: [id])
}

model Tip {
  id           String       @id @default(cuid())
  title        String
  content      String
  excerpt      String
  coverImage   String?
  category     String
  authorId     String
  status       TipStatus    @default(DRAFT)
  rejectReason String?
  views        Int          @default(0)
  likes        Int          @default(0)
  readTime     Int          @default(5)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments     TipComment[]
}

model TipComment {
  id        String   @id @default(cuid())
  tipId     String
  userId    String
  content   String
  createdAt DateTime @default(now())
  tip       Tip      @relation(fields: [tipId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Withdrawal {
  id         String           @id @default(cuid())
  providerId String
  amount     Float
  phone      String
  status     WithdrawalStatus @default(PENDING)
  mpesaRef   String?
  failReason String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  provider   Provider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model Video {
  id           String         @id @default(cuid())
  userId       String
  providerId   String?
  caption      String
  videoUrl     String
  publicId     String?
  thumbnailUrl String?
  hashtags     String[]
  rating       Int?
  duration     Int?
  views        Int            @default(0)
  likes        Int            @default(0)
  reportCount  Int            @default(0)
  createdAt    DateTime       @default(now())
  provider     Provider?      @relation(fields: [providerId], references: [id])
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments     VideoComment[]
  videoLikes   VideoLike[]
  reports      VideoReport[]
}

model VideoComment {
  id        String   @id @default(cuid())
  videoId   String
  userId    String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model VideoReport {
  id        String   @id @default(cuid())
  videoId   String
  userId    String
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
}

model VideoLike {
  id        String   @id @default(cuid())
  videoId   String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
}

model Referral {
  id             String         @id @default(cuid())
  referrerId     String
  referredId     String?
  code           String         @unique
  status         ReferralStatus @default(PENDING)
  rewardAmount   Float          @default(200)
  discountAmount Float          @default(100)
  rewardPaid     Boolean        @default(false)
  createdAt      DateTime       @default(now())
  completedAt    DateTime?
  referred       User?          @relation("ReferredReferrals", fields: [referredId], references: [id])
  referrer       User           @relation("ReferrerReferrals", fields: [referrerId], references: [id])
}

model Promotion {
  id            String       @id @default(cuid())
  providerId    String
  title         String
  description   String?
  imageUrl      String?
  originalPrice Int?
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Float
  startDate     DateTime     @default(now())
  endDate       DateTime
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  provider      Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model Reward {
  id          String       @id @default(cuid())
  userId      String
  type        RewardType
  amount      Float
  description String
  status      RewardStatus @default(PENDING)
  referralId  String?
  expiresAt   DateTime?
  createdAt   DateTime     @default(now())
  usedAt      DateTime?
  user        User         @relation(fields: [userId], references: [id])
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum ProviderCategory {
  FUNDI
  SHOP
  HOTEL
  RESTAURANT
  TECH
  PROFESSIONAL
  BUSINESS
}

enum BookingStatus {
  PENDING
  ACCEPTED
  DECLINED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  PREPARING
  READY
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentTxStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentType {
  STK_PUSH
  CALLBACK
}

enum PriceType {
  FIXED
  FROM
  NEGOTIABLE
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PostType {
  WORK
  PROMOTION
  UPDATE
}

enum NotificationType {
  NEW_BOOKING
  BOOKING_ACCEPTED
  BOOKING_DECLINED
  PAYMENT_RECEIVED
  BOOKING_REMINDER
  SYSTEM
  BOOKING_COMPLETED
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CertificateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PortfolioVideoStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TipStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ReferralStatus {
  PENDING
  REGISTERED
  COMPLETED
  REWARDED
}

enum RewardType {
  REFERRAL_BONUS
  FIRST_BOOKING_DISCOUNT
  LOYALTY_BONUS
  PROMO_CODE
}

enum RewardStatus {
  PENDING
  ACTIVE
  USED
  EXPIRED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model TrustScore {
  id            String     @id @default(cuid())
  userId        String     @unique
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  score         Float      @default(50)
  level         TrustLevel @default(NEW)
  totalReports  Int        @default(0)
  falseReports  Int        @default(0)
  completedJobs Int        @default(0)
  cancelledJobs Int        @default(0)
  noShowCount   Int        @default(0)
  latePayments  Int        @default(0)
  verifiedPhone Boolean    @default(false)
  verifiedId    Boolean    @default(false)
  verifiedFace  Boolean    @default(false)
  updatedAt     DateTime   @updatedAt
  createdAt     DateTime   @default(now())
}

enum TrustLevel {
  NEW
  BASIC
  TRUSTED
  VERIFIED
  ELITE
  SUSPENDED
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  reporter    User         @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId  String
  reported    User         @relation("ReportedReports", fields: [reportedId], references: [id], onDelete: Cascade)
  type        ReportType
  description String
  evidence    String?
  status      ReportStatus @default(PENDING)
  adminNote   String?
  bookingId   String?
  createdAt   DateTime     @default(now())
  resolvedAt  DateTime?
}

enum ReportType {
  FAKE_PROVIDER
  NO_SHOW
  POOR_QUALITY
  OVERCHARGING
  HARASSMENT
  FAKE_REVIEWS
  PAYMENT_FRAUD
  IMPERSONATION
  SCAM
  OTHER
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

model FraudAlert {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        FraudType
  description String
  severity    FraudSeverity
  resolved    Boolean       @default(false)
  createdAt   DateTime      @default(now())
}

enum FraudType {
  MULTIPLE_ACCOUNTS
  FAKE_REVIEWS
  PAYMENT_MANIPULATION
  SUSPICIOUS_BOOKINGS
  REPEATED_CANCELLATIONS
  IDENTITY_MISMATCH
  UNUSUAL_ACTIVITY
}

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model VerificationRequest {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      VerificationType
  status    VerificationStatus @default(PENDING)
  documents String[]
  adminNote String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

enum VerificationType {
  PHONE
  NATIONAL_ID
  FACE
  BUSINESS
  ADDRESS
}

model SuspensionAppeal {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  suspensionReason String
  appealReason     String
  explanation      String
  evidence         String[]
  contactPhone     String
  contactEmail     String?
  status           AppealStatus @default(PENDING)
  adminNote        String?
  reviewedBy       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  resolvedAt       DateTime?
}

enum AppealStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  MORE_INFO_NEEDED
}

model ProviderAvailability {
  id           String                  @id @default(cuid())
  providerId   String                  @unique
  provider     Provider                @relation(fields: [providerId], references: [id], onDelete: Cascade)
  monday       Boolean                 @default(true)
  tuesday      Boolean                 @default(true)
  wednesday    Boolean                 @default(true)
  thursday     Boolean                 @default(true)
  friday       Boolean                 @default(true)
  saturday     Boolean                 @default(false)
  sunday       Boolean                 @default(false)
  startTime    String                  @default("08:00")
  endTime      String                  @default("18:00")
  slotDuration Int                     @default(60)
  breakStart   String?
  breakEnd     String?
  updatedAt    DateTime                @updatedAt
  createdAt    DateTime                @default(now())
  exceptions   AvailabilityException[]
}

model AvailabilityException {
  id             String               @id @default(cuid())
  availabilityId String
  availability   ProviderAvailability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)
  date           DateTime
  isAvailable    Boolean              @default(false)
  reason         String?
  createdAt      DateTime             @default(now())
}

model Payout {
  id          String       @id @default(cuid())
  providerId  String
  provider    Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  amount      Float
  phone       String
  status      PayoutStatus @default(PENDING)
  mpesaRef    String?
  adminNote   String?
  requestedAt DateTime     @default(now())
  processedAt DateTime?
}

enum PayoutStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

model ProviderLocation {
  id         String   @id @default(cuid())
  providerId String   @unique
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  heading    Float?
  speed      Float?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

model UserInteraction {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  type       String
  count      Int      @default(1)
  lastAt     DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userId, providerId, type])
}
